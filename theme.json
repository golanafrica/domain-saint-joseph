{
    "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "color": {
            "palette": [
                {
                    "slug": "primary",
                    "color": "#1A5276",
                    "name": "Bleu principal"
                },
                {
                    "slug": "accent",
                    "color": "#D4AC0D",
                    "name": "Or (accent)"
                },
                {
                    "slug": "text",
                    "color": "#2C3E50",
                    "name": "Texte"
                },
                {
                    "slug": "white",
                    "color": "#FFFFFF",
                    "name": "Blanc"
                },
                {
                    "slug": "bg-light",
                    "color": "#F8F9FA",
                    "name": "Fond clair"
                },
                {
                    "slug": "success",
                    "color": "#28a745",
                    "name": "Succès (vert)"
                },
                {
                    "slug": "whatsapp",
                    "color": "#25D366",
                    "name": "WhatsApp"
                }
            ],
            "gradients": [
                {
                    "slug": "primary-gradient",
                    "gradient": "linear-gradient(135deg, #1A5276 0%, #0f2a40 100%)",
                    "name": "Dégradé bleu principal"
                },
                {
                    "slug": "cta-gradient",
                    "gradient": "linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%)",
                    "name": "Dégradé clair"
                }
            ],
            "custom": false,
            "defaultPalette": false,
            "defaultGradients": false
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "'Segoe UI', Arial, sans-serif",
                    "slug": "main",
                    "name": "Segoe UI (principale)"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Petit"
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Normal"
                },
                {
                    "slug": "large",
                    "size": "1.25rem",
                    "name": "Grand"
                },
                {
                    "slug": "x-large",
                    "size": "1.75rem",
                    "name": "Très grand"
                },
                {
                    "slug": "xx-large",
                    "size": "2.5rem",
                    "name": "Titre"
                }
            ],
            "customFontSize": false,
            "dropCap": false
        },
        "spacing": {
            "units": ["px", "em", "rem", "%", "vw"],
            "padding": true,
            "margin": true,
            "blockGap": true
        },
        "layout": {
            "contentSize": "800px",
            "wideSize": "1200px"
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--white)",
            "text": "var(--wp--preset--color--text)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--main)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--accent)"
                    }
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "fontWeight": "800"
                },
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "fontWeight": "700"
                },
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "600"
                },
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--accent)",
                    "text": "var(--wp--preset--color--primary)"
                },
                "border": {
                    "radius": "50px"
                },
                "spacing": {
                    "padding": {
                        "top": "12px",
                        "right": "28px",
                        "bottom": "12px",
                        "left": "28px"
                    }
                }
            }
        },
        "blocks": {
            "core/button": {
                "border": {
                    "radius": "50px"
                },
                "color": {
                    "background": "var(--wp--preset--color--accent)",
                    "text": "var(--wp--preset--color--primary)"
                }
            },
            "core/separator": {
                "color": {
                    "text": "var(--wp--preset--color--accent)"
                }
            }
        }
    },
    "templateParts": [
        {
            "name": "header",
            "title": "En-tête",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Pied de page",
            "area": "footer"
        }
    ]
}